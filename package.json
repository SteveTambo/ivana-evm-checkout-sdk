{
  "name": "@habix/ivana-evm-checkout",
  "version": "0.1.0",
  "description": "Non-custodial USDC checkout on Base and Polygon through the IVANA payments engine: plain ERC-20 transfers from the buyer's wallet pay the merchant, VAT, the platform fee and suppliers.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Habix Group",
  "main": "./src/checkout.js",
  "types": "./src/index.d.ts",
  "typesVersions": {
    "*": {
      "server": [
        "./src/server.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/checkout.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=90",
    "prepublishOnly": "npm run test:coverage"
  },
  "keywords": [
    "base",
    "checkout",
    "evm",
    "ivana",
    "non-custodial",
    "payments",
    "phantom",
    "polygon",
    "usdc"
  ],
  "publishConfig": {
    "access": "public"
  }
}
